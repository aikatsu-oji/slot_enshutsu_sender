# 依存パッケージ (setup.bat / npm install で再生成される)
/node_modules/
package-lock.json

# scripts/dev.ps1 が作る実行時ファイル (PID・ログ)
/.run/

# Python
__pycache__/
*.pyc

# オーバーレイ設定のエクスポート (enshutsu_overlay.html の「設定を保存」)
enshutsu_settings*.json

# OS
Thumbs.db
.DS_Store
desktop.ini

# エディタ / Claude Code の設定 (元ファイルは scripts/config/ にあり、scripts\migrate_layout.bat が配置する)
.vscode/
.claude/
